---
layout: base.njk
---
<article class="study">
    <p class="back"><a href="{{ 'notes/' | siteLink(page.url) }}">All notes</a></p>
    <p class="study-kicker">
        <span class="status status-{{ status or 'prototype' }}">{{ (status or 'prototype') | statusLabel }}</span>
        {% if draft %}<span class="status status-draft">Draft · preview only</span>{% endif %}
    </p>
    <h1>{{ title | escape }}</h1>
    <p class="lede">{{ summary | escape }}</p>
    <dl class="facts">
        {% if role %}
        <div>
            <dt>Role</dt>
            <dd>{{ role | escape }}</dd>
        </div>
        {% endif %}
        <div>
            <dt>Written</dt>
            <dd>{% if draft %}Unpublished draft{% else %}{{ page.date | noteDate }}{% endif %}</dd>
        </div>
        {% if repo %}
        <div>
            <dt>Code</dt>
            <dd><a href="{{ repo | escape }}" rel="noopener noreferrer">{{ (repoLabel or "Repository") | escape }}</a></dd>
        </div>
        {% endif %}
        {% if link %}
        <div>
            <dt>{{ (linkLabel or "Link") | escape }}</dt>
            <dd><a href="{{ link | escape }}" rel="noopener noreferrer">{{ (linkText or link) | escape }}</a></dd>
        </div>
        {% endif %}
    </dl>
    <div class="study-body">
        {{ content | safe }}
    </div>
</article>
